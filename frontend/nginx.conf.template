# Rendered by nginx's envsubst at container start.
#
# ${API_UPSTREAM} differs per environment: http://api:8000 under Compose,
# http://<service>.railway.internal:8000 on Railway.
# ${PORT} is assigned by the platform at runtime.
# ${NGINX_RESOLVER} comes from docker-entrypoint.d/10-resolver.envsh.
#
# NGINX_ENVSUBST_FILTER restricts substitution to those three names — without
# it, envsubst would also eat nginx's own $uri / $host / $remote_addr.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # Re-resolve upstreams every 10s. nginx otherwise resolves proxy_pass
    # hostnames once at startup and caches the address for the process's life,
    # so a redeployed upstream (new private IP) silently becomes unreachable
    # and every proxied request times out until nginx itself restarts.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;

    # SPA: unknown paths fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin API proxy - this is why the bundle needs no API URL.
    # The upstream goes through a variable ON PURPOSE: that is what makes nginx
    # use the resolver above at request time rather than caching at startup.
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # SSE needs buffering off, or stage updates arrive in one clump at the end.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 330s;
        proxy_connect_timeout 10s;
    }

    # The Part 2 required surface. Exact-match locations so they win over the
    # SPA fallback above, which would otherwise hand an evaluator index.html.
    # Same timeouts as /api/: POST /generate waits for the whole pipeline, so it
    # needs the long read timeout, not nginx's 60s default.
    location = /generate {
        set $spec_upstream "${API_UPSTREAM}";
        proxy_pass $spec_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 330s;
        proxy_connect_timeout 10s;
    }

    location = /history {
        set $history_upstream "${API_UPSTREAM}";
        proxy_pass $history_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    location /health {
        set $health_upstream "${API_UPSTREAM}";
        proxy_pass $health_upstream$request_uri;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
}
