# Copy to .env and fill in. Never commit the real .env.

# ---------------------------------------------------------------------------
# Model provider: "gemini" (free tier) or "claude" (needs purchased credits)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# --- Gemini (free tier available; limits vary by project/model) ---
# Get a key at https://aistudio.google.com/apikey
# The submitted baseline and live demo use gemini-3.5-flash-lite for all roles.
# Check the active model availability and limits for your project in AI Studio.
GEMINI_API_KEY=
GENERATOR_MODEL_ID=gemini-3.5-flash-lite
REVIEWER_MODEL_ID=gemini-3.5-flash-lite
TAGGER_MODEL_ID=gemini-3.5-flash-lite
# medium measurably improves the Reviewer; high scores no better and can
# truncate its structured output. See the baseline table in README.md.
GEMINI_THINKING_LEVEL=medium

# --- Claude (only used when LLM_PROVIDER=claude) ---
# ANTHROPIC_API_KEY=sk-ant-...
# GENERATOR_MODEL_ID=claude-opus-5
# REVIEWER_MODEL_ID=claude-opus-5
# TAGGER_MODEL_ID=claude-opus-5

# ---------------------------------------------------------------------------
# Database / cache — defaults match the docker-compose service names.
# Leave as-is for local Docker. On Railway these are injected automatically.
# ---------------------------------------------------------------------------
POSTGRES_USER=eklavya
POSTGRES_PASSWORD=eklavya
POSTGRES_DB=eklavya
DATABASE_URL=postgresql+asyncpg://eklavya:eklavya@postgres:5432/eklavya
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# Conservative local demo defaults. Set LLM_REQUESTS_PER_MINUTE below the active
# limit shown for your project/model in AI Studio. Use one worker while enabled.
# Set it to 0 only when relying on provider limits or a distributed limiter.
LLM_MAX_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=14
LLM_CALL_TIMEOUT_SECONDS=40

# These three must stay strictly ordered: pipeline < queue < proxy, where the
# proxy is nginx's proxy_read_timeout (330s, in frontend/nginx.conf.template).
# Each layer then fails inward first, so an overrunning run is terminated by its
# own deadline and reported, rather than truncated mid-flight from outside.
# Part 2's worst path is seven model calls (generate, review, refine, review,
# refine, review, tag) against Part 1's four, which is why 120s was raised.
PIPELINE_DEADLINE_SECONDS=240
SAQ_JOB_TIMEOUT_SECONDS=270

TRANSPORT_MAX_ATTEMPTS=2
# The spec is explicit: "If validation fails -> retry once, then fail
# gracefully." One repair, so two calls per agent at most.
SCHEMA_REPAIR_MAX_ATTEMPTS=1
