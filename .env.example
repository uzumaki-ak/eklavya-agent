# Copy to .env and fill in. Never commit the real .env.

# ---------------------------------------------------------------------------
# Model provider: "gemini" (free tier) or "claude" (needs purchased credits)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# --- Gemini (free tier available; limits vary by project/model) ---
# Get a key at https://aistudio.google.com/apikey
# Model IDs verified 2026-08-27. 3.7 is GA/current; 3.6 is a stable fallback.
# Both list free input/output pricing. Check your active limits in AI Studio.
GEMINI_API_KEY=
GENERATOR_MODEL_ID=gemini-3.7-flash
REVIEWER_MODEL_ID=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low

# --- Claude (only used when LLM_PROVIDER=claude) ---
# ANTHROPIC_API_KEY=sk-ant-...
# GENERATOR_MODEL_ID=claude-opus-5
# REVIEWER_MODEL_ID=claude-opus-5

# ---------------------------------------------------------------------------
# Database / cache — defaults match the docker-compose service names.
# Leave as-is for local Docker. On Railway these are injected automatically.
# ---------------------------------------------------------------------------
POSTGRES_USER=eklavya
POSTGRES_PASSWORD=eklavya
POSTGRES_DB=eklavya
DATABASE_URL=postgresql+asyncpg://eklavya:eklavya@postgres:5432/eklavya
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# Conservative local demo defaults. Set LLM_REQUESTS_PER_MINUTE below the active
# limit shown for your project/model in AI Studio. Use one worker while enabled.
# Set it to 0 only when relying on provider limits or a distributed limiter.
LLM_MAX_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=14
LLM_CALL_TIMEOUT_SECONDS=40
PIPELINE_DEADLINE_SECONDS=120
SAQ_JOB_TIMEOUT_SECONDS=150
TRANSPORT_MAX_ATTEMPTS=2
